{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "murmray-backend",
  "main": "worker.ts",
  "compatibility_date": "2026-05-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
